        "message": "<Logo> doesn't accept that prop. Declared props: lockup, tone, height, basePath, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='lockup'] > Literal[value!=/^(?:wordmark|centered|offset)$/]",
        "message": "<Logo> lockup must be one of 'wordmark' | 'centered' | 'offset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|green|black|cream)$/]",
        "message": "<Logo> tone must be one of 'red' | 'green' | 'black' | 'cream'."
