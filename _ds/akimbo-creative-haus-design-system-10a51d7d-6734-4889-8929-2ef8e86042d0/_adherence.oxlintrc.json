        "message": "<OvalKicker> tone must be one of 'red' | 'cream' | 'black' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|tone|size|key|ref|className|style|children)$/]",
        "message": "<PageTab> doesn't accept that prop. Declared props: number, tone, size."
