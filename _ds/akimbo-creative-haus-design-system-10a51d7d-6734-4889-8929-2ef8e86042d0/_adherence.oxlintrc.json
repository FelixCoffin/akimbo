{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/buttons/**",
              "components/cards/**",
              "components/deck/**",
              "components/doc/**",
              "components/layout/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Futura|Regards|Futura Condensed ExtraBold|Jost))/i]",
        "message": "Font not provided by the design system. Available: Futura, Regards, Futura Condensed ExtraBold, Jost."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:pose|tone|size|basePath|alt|key|ref|className|style|children)$/]",
        "message": "<BoMark> doesn't accept that prop. Declared props: pose, tone, size, basePath, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoMark'] > JSXAttribute[name.name='pose'] > Literal[value!=/^(?:leaping|walking|together|dual|flag|point|stand|relax|super|sitting|pointRight|cherries)$/]",
        "message": "<BoMark> pose must be one of 'leaping' | 'walking' | 'together' | 'dual' | 'flag' | 'point' | 'stand' | 'relax' | 'super' | 'sitting' | 'pointRight' | 'cherries'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|black|cream)$/]",
        "message": "<BoMark> tone must be one of 'red' | 'black' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Box'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|callout|bodyStyle|children|key|ref|className|style|children)$/]",
        "message": "<Box> doesn't accept that prop. Declared props: title, callout, bodyStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|key|ref|className|style|children)$/]",
        "message": "<BulletList> doesn't accept that prop. Declared props: items, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletList'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|green|black)$/]",
        "message": "<BulletList> tone must be one of 'red' | 'green' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|as|arrow|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, as, arrow, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|charcoal|onDark|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'charcoal' | 'onDark' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:hover|href|as|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: hover, href, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|body|slotId|placeholder|tone|key|ref|className|style|children)$/]",
        "message": "<ContentCard> doesn't accept that prop. Declared props: heading, body, slotId, placeholder, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|cream)$/]",
        "message": "<ContentCard> tone must be one of 'red' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckContent'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|label|title|titleFont|titleSize|subtitle|project|page|year|theme|accent|tab|mark|bo|boPose|boBasePath|logoBasePath|children|key|ref|className|style|children)$/]",
        "message": "<DeckContent> doesn't accept that prop. Declared props: kicker, label, title, titleFont, titleSize, subtitle, project, page, year, theme, accent, tab, mark, bo, boPose, boBasePath, logoBasePath, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckContent'] > JSXAttribute[name.name='titleFont'] > Literal[value!=/^(?:condensed|display)$/]",
        "message": "<DeckContent> titleFont must be one of 'condensed' | 'display'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckContent'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark|red)$/]",
        "message": "<DeckContent> theme must be one of 'light' | 'dark' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckContent'] > JSXAttribute[name.name='boPose'] > Literal[value!=/^(?:leaping|walking|together|cherries|dual)$/]",
        "message": "<DeckContent> boPose must be one of 'leaping' | 'walking' | 'together' | 'cherries' | 'dual'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|client|meta|theme|accent|logoBasePath|key|ref|className|style|children)$/]",
        "message": "<DeckCover> doesn't accept that prop. Declared props: title, subtitle, client, meta, theme, accent, logoBasePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckCover'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<DeckCover> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckDivider'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|subtitle|page|theme|accent|bo|boPose|boTone|boBasePath|key|ref|className|style|children)$/]",
        "message": "<DeckDivider> doesn't accept that prop. Declared props: kicker, title, subtitle, page, theme, accent, bo, boPose, boTone, boBasePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckDivider'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|red)$/]",
        "message": "<DeckDivider> theme must be one of 'dark' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckDivider'] > JSXAttribute[name.name='boPose'] > Literal[value!=/^(?:leaping|walking|together|cherries|dual)$/]",
        "message": "<DeckDivider> boPose must be one of 'leaping' | 'walking' | 'together' | 'cherries' | 'dual'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckDivider'] > JSXAttribute[name.name='boTone'] > Literal[value!=/^(?:cream|red|green|black)$/]",
        "message": "<DeckDivider> boTone must be one of 'cream' | 'red' | 'green' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeckSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|accent|paper|ink|padding|children|key|ref|className|style|children)$/]",
        "message": "<DeckSlide> doesn't accept that prop. Declared props: theme, accent, paper, ink, padding, children."
