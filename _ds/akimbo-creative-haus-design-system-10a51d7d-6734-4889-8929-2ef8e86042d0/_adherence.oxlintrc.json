      {
        "selector": "JSXOpeningElement[name.name='DeckSlide'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark|red)$/]",
        "message": "<DeckSlide> theme must be one of 'light' | 'dark' | 'red'."
